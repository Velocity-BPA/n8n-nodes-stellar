{
  "name": "@velocity-bpa/n8n-nodes-stellar",
  "version": "1.0.0",
  "description": "n8n community node for Stellar Horizon API integration",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/velocity-bpa/n8n-nodes-stellar",
  "author": {
    "name": "Velocity BPA",
    "email": "support@velocity-bpa.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velocity-bpa/n8n-nodes-stellar.git"
  },
  "main": "dist/index.js",
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "lint": "eslint nodes credentials --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "n8n-community-node-package",
    "stellar",
    "horizon",
    "blockchain",
    "cryptocurrency",
    "payments"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/StellarApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Stellar/Stellar.node.js"
    ]
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "n8n-workflow": "1.57.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}